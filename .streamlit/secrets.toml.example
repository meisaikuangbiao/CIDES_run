# Streamlit Cloud Secrets 模板
# ---------------------------------------------------------------
# 部署到 Streamlit Community Cloud 时，将以下内容粘贴到
# App settings → Secrets，并填上真实 Key。
#
# 本地开发请继续使用 .env 文件，不需要这个 secrets.toml。
# 若要本地测试 secrets 注入逻辑，可把本文件复制为
# .streamlit/secrets.toml 并填入测试 Key（已加入 .gitignore，不会被提交）。
# ---------------------------------------------------------------

# 必填：模型 API Key（DeepSeek 控制台申请）
DEEPSEEK_API_KEY = "sk-replace-me"

# 模型供应商 base url；用 DeepSeek 官方就保持默认
OPENAI_BASE_URL = "https://api.deepseek.com"

# 默认模型，可不改
SUT_MODEL = "deepseek-v4-flash"
USER_SIM_MODEL = "deepseek-v4-flash"
JUDGE_MODEL = "deepseek-v4-flash"

# 可选：调试时打开 HTTP 日志，否则保持默认
# LLM_HTTP_LOG_LEVEL = "WARNING"

# 可选：请求超时与重试
LLM_REQUEST_TIMEOUT = "60"
LLM_MAX_RETRIES = "3"
